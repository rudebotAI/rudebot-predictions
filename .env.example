# ============================================================
# PredictionBot Environment Variables — Kalshi-only
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Mode: paper or live
BOT_MODE=paper

# --- Kalshi trading auth (required for BOT_MODE=live only) ---
# Create at kalshi.com -> Account -> API Keys. ACCESS_KEY is the key ID;
# PRIVATE_KEY is the RSA PEM (paste with literal \n for one-line env vars).
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY=

# --- Telegram Alerts (required for live; every order needs a Confirm tap) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_REQUIRE_CONFIRM=true

# --- Risk overrides (see config.yaml for the full list) ---
# MAX_DAILY_LOSS_USD=20
# MAX_POSITION_USD=10
# MAX_OPEN_POSITIONS=5
# KELLY_FRACTION=0.25
# BANKROLL_USD=500
# MIN_EDGE_BPS=400
# MAX_DRAWDOWN_PCT=0.08
# MAX_EVENT_EXPOSURE_USD=20
# MAX_DAYS_TO_RESOLUTION=90

# --- Misc ---
# CONFIG_PATH=config.yaml
# PORT=8080
